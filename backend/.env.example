# Supabase Configuration (Cloud Supabase mandatory)
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key
# Only for projects still signing JWTs with the legacy HS256 secret (Settings > API > JWT Secret).
# Projects on asymmetric signing keys (ES256/RS256) are verified via JWKS and need nothing here.
SUPABASE_JWT_SECRET=

# AI Provider API Keys
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key

# Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Auth & CORS
# AUTH_REQUIRED=false is honoured only when ENVIRONMENT=development (requests run as the demo user).
AUTH_REQUIRED=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Uploads & storage
MAX_PDF_MB=100
MAX_PDF_PAGES=800
MAX_AUDIO_MB=150
SIGNED_URL_TTL_SECONDS=600
# Public address of this backend; used to build download links when falling back to local storage.
BACKEND_PUBLIC_URL=http://localhost:8000

# Roles — these emails / Supabase user ids are always promoted to "quản lý" (admin). Comma separated.
ADMIN_EMAILS=
ADMIN_USER_IDS=

# Bank-transfer payments via SePay webhook (https://my.sepay.vn → Webhooks).
# Webhook URL: https://<your-backend>/api/v1/billing/webhook/sepay
# Set ONE of: API key auth ("Authorization: Apikey <key>") or HMAC-SHA256 secret.
SEPAY_API_KEY=
SEPAY_WEBHOOK_SECRET=
# Payment-code prefix; must match "Cấu trúc mã thanh toán" configured in SePay.
PAYMENT_CODE_PREFIX=STD

# Email study reminders (sent REMINDER_LEAD_MINUTES before a scheduled study slot starts).
# Leave SMTP_HOST empty to disable sending (reminders are only logged).
# Gmail example: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_SECURITY=starttls with an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Studia <no-reply@example.com>
SMTP_SECURITY=starttls
REMINDERS_ENABLED=true
REMINDER_LEAD_MINUTES=10
# Learner timezone as a fixed offset from UTC (Vietnam = 7).
TZ_OFFSET_HOURS=7
