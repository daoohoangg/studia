# Sao chép thành .env.local (chạy máy) hoặc khai báo trong Vercel › Settings › Environment Variables.
# Mọi biến NEXT_PUBLIC_* đều hiện trong trình duyệt: chỉ đặt khoá công khai (anon/publishable), KHÔNG đặt service_role.

# Supabase (Project Settings › API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<anon-or-publishable-key>

# Địa chỉ backend FastAPI đã deploy, có đuôi /api/v1 (vd. https://studia-api.onrender.com/api/v1)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Nơi chứa tệp audio Listening (Supabase Storage/R2/S3, bucket công khai). Bỏ trống = dùng /audio/... trong public (chỉ để chạy máy).
NEXT_PUBLIC_AUDIO_BASE_URL=

# Chỉ dùng khi phát triển: bỏ qua đăng nhập (bị bỏ qua ở bản production). Production phải để trống hoặc false.
NEXT_PUBLIC_AUTH_DISABLED=false
# Hiện trang công cụ kiểm thử nội bộ
NEXT_PUBLIC_SHOW_DEV_TOOLS=false
