# Mặc định dùng tên miền sslip.io trỏ về IP 3.25.144.63 (không cần mua domain).
# Có domain riêng thì đặt API_DOMAIN=api.example.com trong deploy/ec2/.env và trỏ A record về Elastic IP.
{$API_DOMAIN:api.3-25-144-63.sslip.io} {
	encode gzip
	request_body {
		max_size 520MB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	# Audio Listening (tệp tĩnh, hỗ trợ Range để tua); đặt NEXT_PUBLIC_AUDIO_BASE_URL=https://<domain>/audio
	handle /audio/* {
		root * /srv
		header Cache-Control "public, max-age=2592000"
		header Access-Control-Allow-Origin "*"
		file_server
	}

	handle {
		reverse_proxy api:8000
	}
}
